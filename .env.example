# ==========================================================================
# mcp_oauth_client.py configuration
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# ==========================================================================

# --- Required: OAuth 2.1 (PKCE + client credentials) ----------------------

# Tenant / gateway base URL. May be given as the bare subdomain host or a full
# URL; it is normalized internally. OAuth and MCP requests are sent here.
# Example: https://aigw-mgogax.data.aigw.integration-cyberark.cloud
TENANT_URL=

# OAuth client identifier issued for your agent/app.
CLIENT_ID=

# OAuth client secret. SECRET — never commit the real value.
CLIENT_SECRET=

# Redirect URI registered for the OAuth client. Must match exactly what the
# client is configured with. The local callback server listens on this
# host/port to receive the authorization code.
# Example: http://localhost:3030/callback
REDIRECT_URI=http://localhost:3030/callback

# --- Required: MCP target -------------------------------------------------

# Path of the MCP endpoint on the gateway (no default — must be set).
# Example: /mcp/deepwikimcp
MCP_PATH=/mcp/deepwikimcp

# --- Optional -------------------------------------------------------------

# OAuth scope requested at authorize/token time. Defaults to "full".
SCOPE=full

# List available tools after connecting. Set to "false" to skip (useful when
# calling a single tool). Defaults to "true".
LIST_TOOLS=true

# Name of a single tool to call after connecting. Leave empty to only connect
# (and list tools, unless LIST_TOOLS=false).
TOOL_NAME=

# JSON object of arguments for TOOL_NAME. Must be valid JSON.
# Example: {"query": "how does auth work"}
TOOL_ARGS_JSON=

# --- Development / troubleshooting ----------------------------------------

# Disable TLS certificate verification for BOTH the token exchange and the
# MCP connection. Set to "true" ONLY for dev/integration gateways that present
# a self-signed certificate. INSECURE — never use with production credentials.
INSECURE_SKIP_VERIFY=false

# Skip the interactive OAuth browser flow and use a pre-obtained token.
# When "true", ACCESS_TOKEN is used directly and only TENANT_URL + MCP_PATH
# are required.
SKIP_OAUTH=false

# Bearer access token used when SKIP_OAUTH=true. Defaults to "dev-token".
ACCESS_TOKEN=
