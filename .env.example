TENANT_URL=http://127.0.0.1:8000
MCP_PATH=/mcp
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=REPLACE_ME
REDIRECT_URI=http://localhost:3030/callback
# OAuth 2.1: PKCE (code_challenge/code_verifier) + client_id and client_secret on token request
SCOPE=full
# Branch stacks only: suffix appended to /OAuth2/Authorize and /OAuth2/Token paths.
# Leave empty for master stack. Example for a branch: OAUTH_ENDPOINT_SUFFIX=-AGAI-1148
OAUTH_ENDPOINT_SUFFIX=
# Set OMIT_CLIENT_SECRET=true to test public client flow (no client_secret sent to Identity)
OMIT_CLIENT_SECRET=false
# Set TAMPER_PKCE=true to verify Identity enforces PKCE: sends a wrong code_verifier, expects rejection
TAMPER_PKCE=false
SKIP_OAUTH=false
ACCESS_TOKEN=
# Optional: call a specific MCP tool. Leave TOOL_NAME empty to only list tools.
TOOL_NAME=list_database_targets__sia_mcp
TOOL_ARGS_JSON={}
# LIST_TOOLS=false to skip listing tools when TOOL_NAME is set (default: true, always list and show annotations).
# Example for ask_question__deepwiki_github (requires repoName and question):
# TOOL_NAME=ask_question__deepwiki_github
# TOOL_ARGS_JSON={"repoName": "facebook/react", "question": "How do I create a component?"}
